# cp .env.example .env && chmod 600 .env
TZ=Asia/Seoul

# CLI 바이너리 경로 (기본: PATH 탐색)
AGENT_AGY_BIN=agy
AGENT_CLAUDE_BIN=claude

# Tier별 기본 모델 / 타임아웃(초)
AGENT_AGY_MODEL=gemini-3.8-flash-medium
AGENT_CLAUDE_MODEL=
# 외부 텍스트(메일/웹) 요약 전용. 도구 없는 claude 로만 실행된다.
AGENT_UNTRUSTED_MODEL=claude-haiku-5-5
AGENT_AGY_TIMEOUT=120
# agy 추론 강도 (low | medium | high). 비우면 agy 기본값
AGENT_AGY_EFFORT=
AGENT_CLAUDE_TIMEOUT=300

# Obsidian Vault (사용자 노트는 루트, 에이전트 폴더는 _ 접두사)
AGENT_VAULT=~/Obsidian

# 문서 색인 (원본은 제자리, 요약본만 Vault/_Extracted/Local_Docs 로). 쉼표로 구분
# 원본 폴더 (기본: ~/Documents, <Vault>/_Assets)
AGENT_DOC_SOURCES=~/Documents,~/Obsidian/_Assets
# 제외 폴더: 원본 루트 기준 상대 경로, glob 가능 (예: 개인,채용/2024*). 민감한 폴더는 꼭 적는다
AGENT_DOC_EXCLUDES=
# 이보다 큰 파일은 건너뜀 (MB)
AGENT_DOC_MAX_MB=50

# 데몬 전용 agy 프로필 (전역 ~/.gemini 와 분리). 0 이면 bwrap 없이 HOME 교체만 한다.
AGENT_AGY_HOME=~/agent/data/agy-home
AGENT_AGY_BWRAP=1

# 아침 브리핑 기본 시각 (처음 한 번만 적용, 이후는 Slack 에서 "브리핑 8시로 바꿔줘")
AGENT_BRIEFING_TIME=07:30

# Slack (slack/manifest.yaml 로 앱 생성). 값 뒤에 주석을 붙이지 말 것 (systemd 가 값으로 읽음)
# 앱 레벨 토큰 xapp-... (connections:write)
SLACK_APP_TOKEN=
# 봇 토큰 xoxb-...
SLACK_BOT_TOKEN=
# 이 사용자 ID(Uxxxx) 외의 메시지는 무시한다. 워크스페이스의 다른 사람이 봇을 조종하지 못하게.
SLACK_ALLOWED_USER_ID=
