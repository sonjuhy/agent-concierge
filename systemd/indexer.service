[Unit]
Description=Document indexer (~/Documents → Obsidian _Extracted + master_index.md)

[Service]
Type=oneshot
WorkingDirectory=%h/agent
EnvironmentFile=%h/agent/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run --frozen python -m indexer
# 첫 색인은 문서 100여 개 × 10초 남짓
TimeoutStartSec=3h
Nice=10
